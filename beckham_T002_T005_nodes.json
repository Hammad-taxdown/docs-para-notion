    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aset-003",
              "name": "message",
              "value": "Perdona, no acabo de entenderte 🤔. ¿Estás dado de alta en la Seguridad Social española? Respóndeme con un sí o un no, por favor.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "orch-set_f1_reintento",
      "name": "Set_F1_reintento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1840,
        2100
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = ($('Formatear_conversacion1').item.json.last_message_content || '').toString().trim();\nconst meses = { enero:1, febrero:2, marzo:3, abril:4, mayo:5, junio:6, julio:7, agosto:8, septiembre:9, setiembre:9, octubre:10, noviembre:11, diciembre:12 };\nlet d = null, m = null, y = null;\n\nlet mm = raw.match(/(\\d{1,2})[\\/\\-.](\\d{1,2})[\\/\\-.](\\d{2,4})/);\nif (mm) { d = +mm[1]; m = +mm[2]; y = +mm[3]; if (y < 100) y += 2000; }\nif (d === null) {\n  const iso = raw.match(/(\\d{4})[\\/\\-.](\\d{1,2})[\\/\\-.](\\d{1,2})/);\n  if (iso) { y = +iso[1]; m = +iso[2]; d = +iso[3]; }\n}\nif (d === null) {\n  const t = raw.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  const dm = t.match(/(\\d{1,2})\\s*(?:de)?\\s*([a-z]+)\\s*(?:de)?\\s*(\\d{4})/);\n  if (dm && meses[dm[2]]) { d = +dm[1]; m = meses[dm[2]]; y = +dm[3]; }\n}\n\nlet resultado = 'reintento';\nlet fecha_alta_norm = null;\nif (d && m && y) {\n  const fecha = new Date(Date.UTC(y, m - 1, d));\n  if (!isNaN(fecha) && fecha.getUTCDate() === d && (fecha.getUTCMonth() + 1) === m) {\n    fecha_alta_norm = fecha.toISOString().slice(0, 10);\n    const limite = new Date(fecha);\n    limite.setUTCMonth(limite.getUTCMonth() + 6);\n    const hoy = new Date();\n    hoy.setUTCHours(0, 0, 0, 0);\n    resultado = (limite >= hoy) ? 'avanza' : 'descarta';\n  }\n}\n\nreturn [{ json: { ...$input.first().json, resultado, fecha_alta_norm } }];\n"
      },
