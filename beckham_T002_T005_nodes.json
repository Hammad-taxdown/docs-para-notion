    {
      "parameters": {
        "jsCode": "const raw = ($('Formatear_conversacion1').item.json.last_message_content || '').toString().toLowerCase();\nconst norm = raw.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst tokens = norm.split(/[^a-z]+/).filter(Boolean);\nconst has = (w) => tokens.includes(w);\n\nconst esNo = has('no') || has('nop') || has('negativo') || /todavia no|aun no|no estoy|no me he/.test(norm);\nconst esSi = has('si') || has('claro') || has('afirmativo') || has('correcto') || has('sip') || has('yes') || has('exacto') || /estoy dado|ya estoy|asi es|ya me di|por supuesto/.test(norm);\n\nlet resultado = 'reintento';\nif (esNo && !esSi) resultado = 'descarta';\nelse if (esSi && !esNo) resultado = 'avanza';\n\nreturn [{ json: { ...$input.first().json, resultado } }];\n"
      },
