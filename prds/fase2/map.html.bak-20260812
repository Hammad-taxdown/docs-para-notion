  why:"El trabajo de las sesiones del 22 al 29 de julio, y el único WP que muere hoy.",
  wps:[
  {id:"WP-01",t:"Filtro F1–F3 en Intercom",st:"done",size:"M",crit:0,dep:"—",
   goal:"Cualificación conversacional en Intercom: residencia → alta en SS → fecha, con el orden correcto y los descartes.",
   steps:["Publicado. Orden: residencia (descarte duro) → alta SS → fecha (F2).","Tag <code>jarry_ignore</code> al inicio, que sigue siendo obligatorio."],verify:"Verificado en producción."},
