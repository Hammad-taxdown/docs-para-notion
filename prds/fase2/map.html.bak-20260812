   verify:"—",note:"<b>Sigue sin dueño nombrado.</b> Es el WP con más riesgo del tramo 4: tamaño L, tres dependencias externas y el penúltimo día útil antes del colchón."}
  ]
}
];

const STMAP={done:["t-done","s-done","terminado"],build:["t-build","s-build","en curso"],
  spec:["t-spec","s-spec","especificado"],skel:["t-skel","s-skel","esqueleto"],
  block:["t-block","s-block","bloqueado"],new:["t-new","s-spec","nuevo hoy"],
  kill:["t-kill","s-kill","cancelado"]};

document.getElementById('olas').innerHTML = OLAS.map((o,i)=>{
  const cards = o.wps.map(w=>{
    const [tg,sc,lab]=STMAP[w.st];
    return `<details class="wp ${sc}">
      <summary>
        <span class="id">${w.id}</span>
        <span class="ti">${w.t}</span>
        <span class="tags">
          <span class="tag ${tg}">${lab}</span>
          <span class="tag t-size">${w.size}</span>
          ${w.crit?'<span class="tag t-crit">camino crítico</span>':''}
        </span>
      </summary>
      <div class="detail">
        <p class="dep">Depende de: ${w.dep}</p>
        <p>${w.goal}</p>
        <p class="lbl">Pasos</p>
        <ol>${w.steps.map(s=>`<li>${s}</li>`).join('')}</ol>
        ${w.verify!=='—'?`<p class="verify"><b>Verificación:</b> ${w.verify}</p>`:''}
        ${w.note?`<p class="lbl">Nota</p><p>${w.note}</p>`:''}
      </div>
    </details>`;
  }).join('');
  return `<details class="wave"${i<2?' open':''}>
    <summary>
      <span class="caret">▶</span>
      <span class="when">${o.when}</span>
      <h3>${o.n} · ${o.t}</h3>
      <span class="meta">${o.wps.length} WP</span>
    </summary>
    <div class="body">
      <p class="why">${o.why}</p>
      ${cards}
    </div>
  </details>`;
}).join('');
</script>
